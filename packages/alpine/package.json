{
    "name": "laravel-precognition-alpine",
    "version": "2.1.1",
    "description": "Laravel Precognition (Alpine).",
    "keywords": [
        "laravel",
        "precognition",
        "alpine"
    ],
    "homepage": "https://github.com/laravel/precognition",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/laravel/precognition"
    },
    "license": "MIT",
    "author": "Laravel",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./axios": {
            "types": "./dist/axios.d.ts",
            "default": "./dist/axios.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "/dist"
    ],
    "scripts": {
        "watch": "rm -rf dist && tsc --watch --preserveWatchOutput",
        "build": "rm -rf dist && tsc",
        "typeCheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "version": "npm pkg set dependencies.laravel-precognition=$npm_package_version"
    },
    "peerDependencies": {
        "alpinejs": "^3.12.1"
    },
    "dependencies": {
        "es-toolkit": "^1.32.0",
        "laravel-precognition": "2.1.1"
    },
    "devDependencies": {
        "@types/alpinejs": "^3.7.1",
        "typescript": "^5.0.0"
    }
}
